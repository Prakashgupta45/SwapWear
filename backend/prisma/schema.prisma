generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth enums ──────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

// ─── Listing enums ────────────────────────────────────────────────────────────

enum Category {
  TOPWEAR
  BOTTOMWEAR
  DRESS
  OUTERWEAR
  FOOTWEAR
  ACCESSORIES
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  AVAILABLE
  RESERVED
  SWAPPED
}

enum SwapRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  // Profile fields (Phase 2)
  bio          String?
  city         String?
  state        String?
  pincode      String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listings             ClothingListing[]
  sentSwapRequests     SwapRequest[]     @relation("SentSwapRequests")
  receivedSwapRequests SwapRequest[]     @relation("ReceivedSwapRequests")
  messages             Message[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model ClothingListing {
  id                 String        @id @default(uuid())
  ownerId            String
  title              String
  description        String?
  category           Category
  brand              String?
  color              String?
  size               String
  condition          Condition
  estimatedSwapValue Float?
  status             ListingStatus @default(AVAILABLE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  owner            User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images           ClothingImage[]
  offeredInSwaps   SwapRequest[]   @relation("OfferedInSwaps")
  requestedInSwaps SwapRequest[]   @relation("RequestedInSwaps")

  @@index([ownerId])
  @@index([status])
  @@index([category])
  @@map("clothing_listings")
}

model ClothingImage {
  id        String   @id @default(uuid())
  listingId String
  imageUrl  String
  createdAt DateTime @default(now())

  listing ClothingListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("clothing_images")
}

model SwapRequest {
  id                 String            @id @default(uuid())
  requesterId        String
  recipientId        String
  offeredListingId   String
  requestedListingId String
  message            String?
  status             SwapRequestStatus @default(PENDING)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  requester        User            @relation("SentSwapRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient        User            @relation("ReceivedSwapRequests", fields: [recipientId], references: [id], onDelete: Cascade)
  offeredListing   ClothingListing @relation("OfferedInSwaps", fields: [offeredListingId], references: [id], onDelete: Cascade)
  requestedListing ClothingListing @relation("RequestedInSwaps", fields: [requestedListingId], references: [id], onDelete: Cascade)
  conversation     Conversation?

  @@index([requesterId])
  @@index([recipientId])
  @@index([offeredListingId])
  @@index([requestedListingId])
  @@index([status])
  @@map("swap_requests")
}

model Conversation {
  id            String       @id @default(uuid())
  swapRequestId String       @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  swapRequest   SwapRequest  @relation(fields: [swapRequestId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([swapRequestId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

