# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/swapwear_db?schema=public"

# Authentication & Security
JWT_SECRET="swapwear_super_secret_jwt_key_at_least_32_characters_long_for_security_2026"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="swapwear_secure_cookie_secret_key_prod_quality_2026"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:3000"
